# =============================================================================
# RIENDA · Variables de entorno
#
# Copiar a `.env.local` y completar. `.env.local` NO se versiona: contiene
# credenciales, y este sistema maneja datos personales y de menores.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# La URL y la clave anónima viajan al navegador (prefijo NEXT_PUBLIC). No son
# secretas: lo que protege los datos son las políticas RLS, no ocultar la clave.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La clave de servicio SALTA las políticas RLS. Sólo para trabajos programados y
# webhooks, siempre del lado del servidor. Nunca con prefijo NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# --- Integraciones externas ---------------------------------------------------
# Ninguna bloquea el desarrollo; sí la puesta en producción.

# WhatsApp Cloud API (M5). Número NUEVO y propio del sistema (RN-16).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# MercadoPago (M4)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ARCA / factura electrónica (M6), vía @arcasdk/core (WSAA + WSFEv1).
# Certificado y clave privada en base64 del PEM entero: un valor con saltos de
# línea no sobrevive igual a un .env local que al cuadro de texto de Vercel, y
# codificarlo evita esa clase de bug. Se decodifican en src/lib/arca.ts.
#   openssl base64 -A -in archivo.crt   (o .key)
# ARCA_PRODUCCION=false usa el ambiente de homologación (wsaahomo/wswhomo), con
# un certificado autogestionado por WSASS con la clave fiscal de cualquier
# integrante — no requiere la identidad fiscal del haras. El punto de venta
# real de producción se da de alta durante el trámite del certificado
# definitivo y todavía no se conoce (RN-03); en homologación puede ser
# cualquiera ya habilitado para pruebas del CUIT que firma el certificado.
ARCA_CUIT=
ARCA_CERTIFICADO_B64=
ARCA_CLAVE_PRIVADA_B64=
ARCA_PUNTO_VENTA=
ARCA_PRODUCCION=false

# Correo transaccional
RESEND_API_KEY=

# --- Automatizaciones (M15) ----------------------------------------------------
# Vercel firma sus propios crons con este valor en el header Authorization
# (`Bearer <CRON_SECRET>`): sin él, cualquiera que adivine la URL del cron
# podría disparar los avisos de cobranza del día. Vercel lo agrega solo cuando
# la variable existe en el proyecto; no hace falta configurarlo del lado de
# Vercel además de cargarlo acá.
CRON_SECRET=
